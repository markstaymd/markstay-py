          "dst": "new.md",
          "before": null,
          "after": "A rewritten.\n<!-- stay:a -->\n"
        }
      ],
      "expected": {
        "pairings": [{ "path": "new.md", "baseline": "old.md" }],
        "reports": [
          {
            "label": "new.md (baseline old.md)",
            "findings": [
              { "level": "error", "code": "DROPPED_ID", "id": "b", "line": null },
              { "level": "warn", "code": "HASH_DRIFT", "id": "a", "line": null }
            ]
          }
        ],
        "notes": [],
        "hasErrors": true
      }
    },
